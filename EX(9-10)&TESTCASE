    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split, KFold, cross_val_score\n",
    "from sklearn.preprocessing import MinMaxScaler, PolynomialFeatures\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.linear_model import LinearRegression\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# dataset\n",
    "housing = pd.DataFrame({\n",
    "'area':[800,900,1000,1200,1500,1800,2000,2300,2600,3000,3200,3500,3700,4000,4200,4500,4800,5000,5300,5600],\n",
    "'price':[200000,220000,250000,300000,350000,380000,420000,460000,500000,550000,580000,620000,650000,700000,730000,780000,820000,860000,900000,950000]\n",
    "})\n",
    "\n",
    "print(\"First 5 rows of dataset:\\n\", housing.head())\n",
    "print(\"\\nTotal observations:\", len(housing))\n",
    "\n",
    "# scaling\n",
    "df = pd.DataFrame(MinMaxScaler().fit_transform(housing), columns=['area','price'])\n",
    "\n",
    "# plot\n",
    "sns.regplot(x=\"area\", y=\"price\", data=df, fit_reg=False)\n",
    "plt.title(\"Area vs Price (Scaled)\")\n",
    "plt.show()\n",
    "\n",
    "# split data\n",
    "train, test = train_test_split(df, train_size=0.7, random_state=10)\n",
    "print(\"\\nTraining size:\", len(train))\n",
    "print(\"Testing size:\", len(test))\n",
    "\n",
    "X_train = train[['area']]\n",
    "y_train = train['price']\n",
    "X_test = test[['area']]\n",
    "y_test = test['price']\n",
    "\n",
    "# polynomial regression\n",
    "model = make_pipeline(PolynomialFeatures(2), LinearRegression())\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "print(\"\\nModel Performance\")\n",
    "print(\"Training R^2 Score:\", model.score(X_train, y_train))\n",
    "print(\"Testing R^2 Score:\", model.score(X_test, y_test))\n",
    "\n",
    "# cross validation\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=10)\n",
    "scores = cross_val_score(model, X_train, y_train, cv=kf, scoring='r2')\n",
    "\n",
    "print(\"\\nCross Validation R^2 Scores:\", scores)\n",
    "print(\"Average CV Score:\", np.mean(scores))"
